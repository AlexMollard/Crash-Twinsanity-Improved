gametitle=Crash Twinsanity (PAL) (SLES-52568) 1510E1D1 - original ISO

[480p Mode (60Hz)]
gsinterlacemode=1
author=PeterDelta
description=Runs the game in 480p progressive at 60Hz instead of 50Hz PAL. FMVs play ~10% fast, gameplay OK.
patch=1,EE,002C24A4,word,24110001
patch=1,EE,002C24A8,word,24120050
